# Quanti — variables de entorno (C-01 foundation-infra)
# Copiar a `.env.local` y pegar los valores reales (el usuario los provee).
# NUNCA commitear `.env.local` (R3) — verificado con `git check-ignore -v .env.local`.
# `.env.example` solo lleva placeholders, jamás secretos reales.
#
# Supabase — proyecto ya creado en el dashboard (browser).
# Pegar desde: Supabase Dashboard → Project Settings → API.
#
# URL pública del proyecto (no sensible, pero va por env para no hardcodear).
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# Clave anon pública (protegida por RLS; puede ir con prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON
# Clave service_role — SOLO SERVIDOR (R3). Nunca NEXT_PUBLIC_*, nunca en Client Components (R1).
# Solo se usa en Route Handlers / Server Actions puntuales (ver lib/supabase/server.ts).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_SERVICE_ROLE
#
# Resend — verificación real en C-09. En C-01 solo se declara el contrato.
RESEND_API_KEY=re_PLACEHOLDER
# Casilla corporativa destino del formulario (se confirma en C-09).
CONTACTO_DESTINO=contacto@quantihidroponia.com.ar
# Remitente verificado en Resend (se verifica en C-09).
RESEND_REMITENTE=contacto@quantihidroponia.com.ar
