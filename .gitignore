# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# C-05: artefactos E2E (credenciales efímeras de usuarios de prueba, nunca al repo — R3)
.e2e-credentials.json
.e2e-run-id
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/
.lighthouseci/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# C-01: el archivo real con secretos nunca entra al repo (R3).
# Verificado con `git check-ignore -v .env.local`.
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local: preferencias de Claude Code, estado del orquestador y memoria engram (repo público)
.claude/settings.json
.active-orchestrator-state.json
.engram/
